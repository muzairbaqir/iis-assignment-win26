<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Manipulator Arm Macro                      -->
  <!-- ========================================== -->
  <xacro:macro name="manipulator_arm" params="parent_link link1_length link2_length link_radius mass_link1 mass_link2">
    
    <!-- Shoulder Joint: connects base to upper arm -->
    <joint name="shoulder_pitch_joint" type="revolute">
      <parent link="${parent_link}"/>
      <child link="upper_arm_link"/>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="50.0" velocity="1.0"/>
    </joint>

    <!-- Upper Arm Link (Link 1) -->
    <link name="upper_arm_link">
      <inertial>
        <origin xyz="0 0 ${link1_length / 2.0}" rpy="0 0 0"/>
        <mass value="${mass_link1}"/>
        <inertia 
          ixx="${(mass_link1/12.0) * (3*link_radius*link_radius + link1_length*link1_length)}" 
          ixy="0.0" ixz="0.0"
          iyy="${(mass_link1/12.0) * (3*link_radius*link_radius + link1_length*link1_length)}" 
          iyz="0.0"
          izz="${(mass_link1/2.0) * (link_radius*link_radius)}"
        />
      </inertial>
      <visual>
        <origin xyz="0 0 ${link1_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link_radius}" length="${link1_length}"/>
        </geometry>
        <material name="metallic_blue">
          <color rgba="0.2 0.4 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${link1_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link_radius}" length="${link1_length}"/>
        </geometry>
      </collision>
    </link>

    <!-- Elbow Joint: connects upper arm to forearm -->
    <joint name="elbow_pitch_joint" type="revolute">
      <parent link="upper_arm_link"/>
      <child link="forearm_link"/>
      <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.0" upper="2.0" effort="40.0" velocity="1.2"/>
    </joint>

    <!-- Forearm Link (Link 2) -->
    <link name="forearm_link">
      <inertial>
        <origin xyz="0 0 ${link2_length / 2.0}" rpy="0 0 0"/>
        <mass value="${mass_link2}"/>
        <inertia 
          ixx="${(mass_link2/12.0) * (3*link_radius*link_radius + link2_length*link2_length)}" 
          ixy="0.0" ixz="0.0"
          iyy="${(mass_link2/12.0) * (3*link_radius*link_radius + link2_length*link2_length)}" 
          iyz="0.0"
          izz="${(mass_link2/2.0) * (link_radius*link_radius)}"
        />
      </inertial>
      <visual>
        <origin xyz="0 0 ${link2_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link_radius}" length="${link2_length}"/>
        </geometry>
        <material name="metallic_silver">
          <color rgba="0.7 0.7 0.75 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${link2_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link_radius}" length="${link2_length}"/>
        </geometry>
      </collision>
    </link>

    <!-- Wrist Roll Joint: essential for rotating/pouring liquid -->
    <joint name="wrist_roll_joint" type="revolute">
      <parent link="forearm_link"/>
      <child link="wrist_link"/>
      <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="20.0" velocity="1.5"/>
    </joint>

    <!-- Wrist Link -->
    <link name="wrist_link">
      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.04"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.04"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>

</robot>
