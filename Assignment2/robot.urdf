<?xml version="1.0" ?>
<robot name="domestic_assistant_robot">

  <!-- ========================================== -->
  <!-- World Ground Link                          -->
  <!-- ========================================== -->
  <link name="world"/>

  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- 1. Base Component (Pedestal Base)          -->
  <!-- ========================================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.150" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.34687" ixy="0.0" ixz="0.0" iyy="0.34687" iyz="0.0" izz="0.46875"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.150" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.30"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.150" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.30"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================================== -->
  <!-- 2. Manipulator Arm                         -->
  <!-- ========================================== -->
  <!-- Shoulder Joint -->
  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50.0" velocity="1.0"/>
  </joint>

  <!-- Upper Arm Link -->
  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.04319" ixy="0.0" ixz="0.0" iyy="0.04319" iyz="0.0" izz="0.00200"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.45"/>
      </geometry>
      <material name="metallic_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.45"/>
      </geometry>
    </collision>
  </link>

  <!-- Elbow Joint -->
  <joint name="elbow_pitch_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="40.0" velocity="1.2"/>
  </joint>

  <!-- Forearm Link -->
  <link name="forearm_link">
    <inertial>
      <origin xyz="0 0 0.200" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02747" ixy="0.0" ixz="0.0" iyy="0.02747" iyz="0.0" izz="0.00160"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.200" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.40"/>
      </geometry>
      <material name="metallic_silver">
        <color rgba="0.7 0.7 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.200" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.40"/>
      </geometry>
    </collision>
  </link>

  <!-- Wrist Roll Joint (for pouring motions) -->
  <joint name="wrist_roll_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20.0" velocity="1.5"/>
  </joint>

  <!-- Wrist Link -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00010" ixy="0.0" ixz="0.0" iyy="0.00010" iyz="0.0" izz="0.00010"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================================== -->
  <!-- 3. Parallel Gripper (End-Effector)         -->
  <!-- ========================================== -->
  <!-- Gripper Base Joint -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="gripper_palm_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Gripper Palm -->
  <link name="gripper_palm_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00030" ixy="0.0" ixz="0.0" iyy="0.00030" iyz="0.0" izz="0.00050"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.12 0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.12 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Finger Joint (Prismatic, opens up to 0.07 m from center) -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_palm_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.02 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.07" effort="30.0" velocity="0.2"/>
  </joint>

  <!-- Left Finger Link -->
  <link name="left_finger_link">
    <inertial>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.12"/>
      </geometry>
      <material name="rubber_grey">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Finger Joint (Prismatic, opens symmetrically) -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_palm_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.02 0.04" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.07" effort="30.0" velocity="0.2"/>
  </joint>

  <!-- Right Finger Link -->
  <link name="right_finger_link">
    <inertial>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.12"/>
      </geometry>
      <material name="rubber_grey">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.12"/>
      </geometry>
    </collision>
  </link>

</robot>
